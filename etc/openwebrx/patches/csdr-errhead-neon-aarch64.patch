+#ifdef NEON_OPTS
+// Upstream bug (confirmed unfixed as of this writing - see
+// https://github.com/jketterl/csdr/issues/13, an open, unpatched report
+// of this exact "implicit declaration of function 'errhead'" error on
+// aarch64/Raspberry Pi OS Trixie): this NEON_OPTS-only debug-trace block
+// calls errhead(), which is defined ONLY in the separate csdr.c CLI
+// tool (src/csdr.c) and depends on that tool's own argv_global/
+// argc_global - neither declared in any shared header, nor meaningful
+// in this library's context. NEON_OPTS is unconditionally enabled for
+// every aarch64 build (CMakeLists.txt: "aarch64 mandated neon"), so
+// this affects any aarch64 build, not just this one; older GCC only
+// warned on the implicit declaration (and this shared library likely
+// still linked, leaving a latent dangling/undefined-behavior debug
+// path), but GCC 14+ (Debian Trixie's default) promotes
+// -Wimplicit-function-declaration to a hard error for C, turning this
+// long-latent bug into a build failure. This local stand-in preserves
+// the intended trace-prefix behavior (a short line prefix before each
+// debug value) without the bogus cross-translation-unit dependency.
+static void errhead(void) {
+    fprintf(stderr, "libcsdr: ");
+}
+#endif
