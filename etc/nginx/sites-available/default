# -------------------------------------------------
# PirateBox - captive-portal
# -------------------------------------------------

server {
    client_max_body_size 150M;

    listen 80 default_server;
    server_name _;

    root /var/www/html/public;
    index index.php index.html;

    # Apple - iOS / macOS captive portal detection
    location = /hotspot-detect.html {
        return 302 http://10.0.0.1/;
    }

    location = /library/test/success.html {
        return 302 http://10.0.0.1/;
    }

    location = /success.html {
        return 302 http://10.0.0.1/;
    }

    # RFC 8908 Captive Portal API, advertised to clients via DHCP option 114
    # (RFC 8910, see dnsmasq.conf). Always reports captive=true - this
    # network never gains real Internet access, so there is no "accept" flow
    # to unlock; user-portal-url points at the real PirateBox homepage.
    # Plain HTTP is intentional: neither RFC mandates TLS, and this project
    # does not implement TLS/HTTPS interception.
    location = /.well-known/captive-portal {
        default_type application/captive+json;
        add_header Cache-Control "private, no-store" always;
        return 200 '{"captive":true,"user-portal-url":"http://10.0.0.1/"}';
    }

    # Android / ChromeOS captive portal detection
    location = /generate_204 {
        return 302 http://10.0.0.1/;
    }

    location = /gen_204 {
        return 302 http://10.0.0.1/;
    }

    # Modern Windows NCSI
    location = /connecttest.txt {
        return 302 http://10.0.0.1/;
    }

    # Older Windows NCSI
    location = /ncsi.txt {
        return 302 http://10.0.0.1/;
    }

    # Phase 4: admin/status page. HTTP Basic Auth on this one path only -
    # everything else on the site stays open, matching PirateBox's
    # no-accounts design. auth_basic_user_file is created empty (locked
    # out - no default credential) by the installer; run
    # setup_admin_password.sh to set a real password. See
    # docs/OPERATIONAL-DECISIONS.md.
    location ^~ /admin/ {
        auth_basic "PirateBox Admin";
        auth_basic_user_file /etc/nginx/.piratebox_admin_htpasswd;

        try_files $uri $uri/ /admin/index.php?$args;

        # Explicit auth_basic repeated here too (nginx already inherits it
        # from the parent block) so this stays protected even if the
        # blocks above are ever reordered or split apart.
        location ~ \.php$ {
            auth_basic "PirateBox Admin";
            auth_basic_user_file /etc/nginx/.piratebox_admin_htpasswd;

            try_files $uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $document_root;
            fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        }
    }

    # Round 9: static assets (JS/CSS/images/fonts) get an explicit
    # Cache-Control so a browser always revalidates with the server
    # before reusing a cached copy. Before this, no Cache-Control
    # header was set at all here, so browsers fell back to heuristic
    # freshness (commonly a fraction of the file's age since it was
    # last modified) - this was a real, confirmed cause of the round-8
    # theme-selector bug report: a browser could silently keep serving
    # an old cached assets/scripts.js or assets/styles.css after a
    # deploy, with no visible error, until its own heuristic window
    # happened to expire. "no-cache" (despite the name) still allows
    # normal fast conditional-GET caching (a 304 when nothing changed,
    # no re-download) - it just guarantees a check against the
    # server's current ETag/Last-Modified happens on every use, so a
    # real deploy is picked up on the very next load rather than after
    # an unpredictable, browser-specific delay. See
    # docs/OPERATIONAL-DECISIONS.md "Round 9: Theme Selector Regression
    # - Root Cause and Fix" for the full diagnosis.
    location ^~ /assets/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # PirateBox application
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # PHP
    location ~ \.php$ {
        try_files $uri =404;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;

        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Block hidden files
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }
}
