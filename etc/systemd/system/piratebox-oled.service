# /etc/systemd/system/piratebox-oled.service
[Unit]
Description=PirateBox OLED status display daemon (SSD1306, I2C1)
# See piratebox_oled_daemon.py for exactly what this does and why.
# Runs continuously (its own retry/redraw loop, not a timer) so it can
# recover on its own if the display is unplugged and reconnected -
# see the script's own header for the full degrade/recover contract.
#
# Deliberately AFTER local-fs.target only, not After=network.target or
# any Core service - this daemon has zero dependency on networking or
# on hostapd/dnsmasq/nginx/php-fpm being up, and nothing in Core depends
# on this daemon either (docs/ARCHITECTURE.md §2, docs/HARDWARE-
# INTEGRATION-DESIGN.md §5 "never required for operation").
After=local-fs.target

[Service]
Type=simple
User=piratebox-gpio
Group=gpio
# The button daemon (piratebox-button.service) already runs as this
# same unprivileged system account, in the same gpio group - reused
# here rather than creating a second hardware-access account, per
# docs/HARDWARE-INTEGRATION-DESIGN.md §8's own "one dedicated account"
# framing. SupplementaryGroups=i2c is the one addition this service
# needs beyond what the button daemon already has, for /dev/i2c-1.
SupplementaryGroups=i2c
ExecStart=/usr/local/bin/piratebox_oled_daemon.py
Restart=on-failure
RestartSec=5

# No sudo grant of any kind - this daemon has no privileged action to
# escalate to (unlike piratebox-button.service's narrow poweroff grant).
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# gpiozero isn't used here, but luma.oled/Pillow may want a writable
# scratch directory for font caching - point it at this service's own
# private, tmpfs-backed /tmp (same fix piratebox-button.service already
# needed for gpiozero's own notification pipe) rather than "/", which
# ProtectSystem=strict makes read-only. Zero SD card writes either way.
WorkingDirectory=/tmp
# This daemon touches no PirateBox data file at all (see the script's
# own header - every data source it reads is opened read-only), so it
# needs no other writable paths under ProtectSystem=strict.
#
# BUG FIX (2026-09-04, Silly Mode round): PrivateTmp=yes above means
# this service has always had its OWN private /tmp, never the real
# host one - it could never actually see /tmp/piratebox/mode (the
# Emergency Mode toggle set_piratebox_mode.sh writes) or the new Silly
# Mode toggle. read_mode() has silently always returned "normal" here
# regardless of real state. Fixed with a read-only bind of the real
# host directory into this service's private /tmp namespace -
# etc/tmpfiles.d/piratebox-tmp.conf now pre-creates /tmp/piratebox at
# boot (BEFORE this service starts, via the default tmpfiles-setup
# ordering) specifically so this bind always has something to mount;
# because it's a live bind of the directory (not a one-time copy),
# files created inside it later - a fresh `sudo ./set_piratebox_mode.sh
# emergency` or `piratebox-silly on` - become visible immediately, no
# restart of this service needed.
BindReadOnlyPaths=/tmp/piratebox:/tmp/piratebox

# Added 2026-09-04 (Progression round): the one narrow, durable write
# exception to ProtectSystem=strict this daemon has ever needed - a
# persistent home for piratebox_progression.py's own state (XP/levels/
# achievements/history), which must survive a reboot (unlike everything
# else this daemon touches) and therefore cannot live under /tmp.
# etc/tmpfiles.d/piratebox-tmp.conf pre-creates this directory, owned by
# this same piratebox-gpio account, before this service starts. Nothing
# else this daemon does needs write access anywhere - see the comment
# above about every other data source being read-only.
ReadWritePaths=/var/lib/piratebox-oled

# Added 2026-09-07 (Environment web UI round): a small public export of
# current sensor readings (piratebox_oled_daemon.py's own
# publish_sensors_export(), see that function's header) for the new
# /utility/environment/ page to read - a DIFFERENT concern from
# Progression's own durable state above, so it gets its own directory
# rather than reusing /var/lib/piratebox-oled or being folded into
# progression-public.json. RuntimeDirectory=, not a ReadWritePaths line
# + a manual etc/tmpfiles.d rule: systemd creates /run/piratebox-sensors
# fresh on every start of THIS service (owned by this same User=/Group=,
# mode 0755 so "other" - www-data - can traverse into it and read the
# 0644 file this daemon writes inside), removes it on stop, and this
# alone already grants write access to that one path under
# ProtectSystem=strict - no separate ReadWritePaths= entry needed.
RuntimeDirectory=piratebox-sensors
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
