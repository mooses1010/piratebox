[Unit]
Description=PirateBox physical button daemon (GPIO25 hold-for-shutdown)
# See piratebox_button_daemon.py for exactly what this does and why.
# Runs continuously (event-driven, not polling - see the script's own
# header) rather than on a timer like piratebox-status/piratebox-backup,
# since it must react to a press the moment it happens.
After=multi-user.target

[Service]
Type=simple
User=piratebox-gpio
Group=gpio
ExecStart=/usr/local/bin/piratebox_button_daemon.py
Restart=on-failure
RestartSec=5

# Real shutdown is armed. This was left commented out (dry-run/log-only)
# through discovery, electrical bring-up, and persistent-service
# verification, and enabled only after the persistent service was
# confirmed to correctly distinguish short presses (no-op) from a
# deliberate ~4s hold (log-only) with zero effect on the rest of the
# system - see docs/OPERATIONAL-DECISIONS.md for the full staged
# bring-up and the live shutdown test this enabled.
Environment=PIRATEBOX_BUTTON_ENABLE_SHUTDOWN=1

# Deliberately NOT NoNewPrivileges=yes - this daemon's one legitimate
# job requires escalating via `sudo -n systemctl poweroff` (see
# etc/sudoers.d/piratebox-button), and that hardening flag would block
# exactly that. Every other standard hardening directive below still
# applies; this is the one, understood, load-bearing exception, not an
# oversight.
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# gpiozero's lgpio pin factory writes a small notification-pipe file
# (".lgd-nfy*") into its own working directory - with no WorkingDirectory
# set, systemd defaults to "/", which ProtectSystem=strict makes
# read-only, so every pin factory failed in turn and gpiozero fell back
# to a broken experimental one ("Could not claim GPIO25: [Errno 22]
# Invalid argument" - found running this for the first time). Fixed by
# pointing the working directory at this service's own private, tmpfs-
# backed /tmp (PrivateTmp=yes above) - writable, and RAM-only, so this
# still produces zero SD card writes.
WorkingDirectory=/tmp
# This daemon touches no other PirateBox data (see the script's own
# header) beyond the one exception directly below.
#
# Added 2026-09-04 (OLED cadence rebalance round): a short press now
# writes a small timestamp signal for the OLED daemon to interpret (see
# piratebox_button_daemon.py's own STATUS_CHECK_REQUEST_FILE comment).
# PrivateTmp=yes above means this service has its OWN private /tmp -
# without this line, the real host path would be invisible to it, the
# same class of gap Silly Mode's own bring-up found for the OLED
# daemon's read side. Deliberately the single narrowest bind that
# works: read-write access to exactly this one pre-existing file
# (etc/tmpfiles.d/piratebox-tmp.conf creates it, owned by this same
# piratebox-gpio account, before this service starts) - not the whole
# /tmp/piratebox directory, which this daemon has no legitimate reason
# to see any other file in (the mode toggle, Silly Mode's toggle,
# Progression's request files).
BindPaths=/tmp/piratebox/status-check-request:/tmp/piratebox/status-check-request

[Install]
WantedBy=multi-user.target
