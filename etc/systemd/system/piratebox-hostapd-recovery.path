# PirateBox: restart hostapd the moment the pb-ap interface (re)appears.
#
# Companion to etc/systemd/system/hostapd.service.d/override.conf's
# BindsTo=/After=sys-subsystem-net-devices-pb\x2dap.device +
# ConditionPathExists=/sys/class/net/pb-ap - that half is confirmed
# working live (hostapd stops cleanly, once, the instant pb-ap
# disappears, with no restart-loop while it stays absent). This unit is
# the other half: it is what actually brings hostapd back once pb-ap
# exists again.
#
# History: the original 2026-09-05 fix used a udev rule property
# (ENV{SYSTEMD_WANTS}+="hostapd.service") for this half instead of a
# .path unit. It looked correct (present in the rule, byte-verified,
# `udevadm test` computed it) but never actually fired hostapd on a
# real ALFA disconnect/reconnect - root-caused 2026-09-15 to a udev
# action-matching gap (the rule matched ACTION=="add", but the kernel's
# rename fires a separate "move" event that the property never
# survived into) - see docs/OPERATIONAL-DECISIONS.md's dated entry for
# the full evidence, and docs/IMPLEMENTATION-ROADMAP.md's prior entry
# for this gap, which already suggested this exact replacement as
# "more battle-tested, inotify-backed" than udev's per-rule property
# translation. Using PathExists= here sidesteps the udev action
# question entirely: systemd's own path-unit inotify watch fires
# whenever /sys/class/net/pb-ap transitions from absent to present,
# regardless of which specific uevent action the kernel used to get
# there.
#
# No restart-loop risk: a .path unit only triggers its Unit= on an
# absent->present transition, not repeatedly while the path stays
# present, and it takes no action at all while the ALFA is genuinely
# absent (nothing to watch appearing). Starting hostapd.service while
# it is already active is an ordinary idempotent no-op job, matching
# the same "harmless on an ordinary cold boot too" reasoning the
# original udev-based fix relied on.
[Unit]
Description=PirateBox: trigger hostapd start when pb-ap (re)appears
Documentation=man:systemd.path(5)

[Path]
PathExists=/sys/class/net/pb-ap
Unit=hostapd.service

[Install]
WantedBy=multi-user.target
