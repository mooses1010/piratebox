# /etc/systemd/system/piratebox-esp32-supervisor.service
[Unit]
Description=PirateBox ESP32-S3 hardware/sensor supervisor link (serial)
# See piratebox_esp32_supervisor.py for exactly what this does and why.
# Runs continuously (its own reconnect-poll loop, not a timer) so it
# recovers on its own if the board/hub/cable is unplugged and later
# reconnected - same "own retry loop, never crash on absence" contract
# as piratebox-oled.service. After local-fs.target only: this daemon
# has zero dependency on networking or on hostapd/dnsmasq/nginx/php-fpm
# being up, and nothing in Core depends on it either (docs/ARCHITECTURE.md
# §3's "companion devices must be able to disappear without breaking
# Core" - the ESP32 supervisor is exactly such a device).
After=local-fs.target

[Service]
Type=simple
User=piratebox-gpio
Group=gpio
# Reuses the same dedicated, unprivileged account the OLED/button
# daemons already run as (docs/HARDWARE-INTEGRATION-DESIGN.md §8's
# "one dedicated account" framing) - SupplementaryGroups=dialout is the
# one addition this service needs beyond what that account already has,
# for the /dev/ttyACM0-style serial device node (group-owned `dialout`,
# confirmed 2026-09-07 commissioning).
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/piratebox_esp32_supervisor.py
Restart=on-failure
RestartSec=5

# No sudo grant of any kind - this daemon has no privileged action to
# escalate to. It only reads a serial port and writes its own small
# export under RuntimeDirectory= below, plus its own durable state
# under StateDirectory= below.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
WorkingDirectory=/tmp

# The one small public export this daemon writes - same RuntimeDirectory=
# pattern as piratebox-oled.service's own /run/piratebox-sensors (see
# that unit's comment for the full rationale): systemd creates
# /run/piratebox-esp32 fresh on every start (owned by this same
# User=/Group=, mode 0755 so www-data can traverse into it and read the
# 0644 file this daemon writes inside), removes it on stop. This is
# tmpfs-backed and deliberately ephemeral - never used for anything that
# must survive a reboot (that's StateDirectory= below).
RuntimeDirectory=piratebox-esp32
RuntimeDirectoryMode=0755

# DS18B20 probe naming (2026-09-07) - see piratebox_ds18b20_roles.py's
# own header. Unlike RuntimeDirectory= above, StateDirectory= creates a
# PERSISTENT directory under /var/lib/ that survives reboots - exactly
# what a durable ROM-address-to-name mapping needs. Mode 0770 (not the
# usual 0750) is deliberate: it lets the `moose` account (already a
# member of the `gpio` group - confirmed 2026-09-07) write the small
# naming-request file tools/ds18b20_commission.py drops here, without
# any sudo grant or bind-mount indirection - the daemon (running as
# this same User=/Group=) is still the only process that ever writes
# the durable roles file itself (see that module's "single-writer"
# rationale).
StateDirectory=piratebox-esp32
StateDirectoryMode=0770

[Install]
WantedBy=multi-user.target
