#!/bin/bash
#
# Toggle and inspect PirateBox OLED Silly Mode + its underlying
# Progression subsystem (XP/levels/titles/achievements/history - see
# piratebox_progression.py's own header for the full design). This is
# deliberately NOT set_piratebox_mode.sh: none of this is trusted
# operational state (it can never appear, or hide, Emergency Mode or a
# real fault - see compute_display_tier() in the daemon), it's a desk-
# facing cosmetic/history layer, so this script needs no root and no
# sudoers entry for its everyday commands.
#
#   piratebox-silly on               - enable Silly Mode
#   piratebox-silly off              - disable Silly Mode (plain status rotation)
#   piratebox-silly status           - current Silly Mode + Emergency Mode state
#   piratebox-silly stats            - Progression summary (level, title, XP,
#                                       lifetime stats, achievement count)
#   piratebox-silly preview          - briefly demo a sampler of ordinary/
#                                       common expressions and animations on
#                                       the real OLED (Silly Mode must already
#                                       be on) - operator-only, never shows
#                                       uncommon/rare/legendary/secret content,
#                                       auto-expires on its own (see below)
#   piratebox-silly backup [path]    - copy the live Progression file out,
#                                       timestamped, to ~/piratebox-progression-
#                                       backups/ by default
#   piratebox-silly reset --confirm-i-am-sure
#                                     - ERASE all XP/levels/achievements/history
#                                       back to a fresh device. Requires typing
#                                       a confirmation phrase interactively
#                                       (or --yes for scripted use) - see below.
#   piratebox-silly import <file>    - stage a previously-exported file for the
#                                       daemon to validate and adopt
#
# Silly Mode's own toggle state lives in /tmp/piratebox/silly (tmpfs) -
# resets to the default OFF on every reboot, same rationale as
# MODE_FILE. The OLED daemon reads this file live, every redraw (~3s) -
# no service restart or signal needed after toggling.
#
# `preview` (Expression Engine v2, 2026-09-04) writes a plain
# timestamp to /tmp/piratebox/silly-preview-request, the same recency-
# based, no-acknowledge signal-file pattern `on`/`off` and the short-
# press status-check override already use - see piratebox_oled_
# daemon.py's read_preview_active()/PREVIEW_PLAYLIST for the OLED side.
# Deliberately requires Silly Mode to already be on (checked below,
# not silently forced on) so this command never has a surprising side
# effect beyond "run the demo" - and deliberately built entirely from
# fixed render-spec dicts on the OLED side, never by calling the
# rarity engine, so it is structurally impossible for this to reveal
# an uncommon/rare/legendary/secret variant regardless of the real
# device's level/history or how many times it's run.
#
# Progression's durable state lives at /var/lib/piratebox-oled/
# progression.json (real disk, survives reboot and Silly Mode being
# off) - owned by the piratebox-gpio account the OLED daemon runs as,
# group `gpio` (which this account's own invoking user is normally
# already a member of - see docs/HARDWARE-INTEGRATION-DESIGN.md §8),
# so `stats`/`backup` can read it directly. This script NEVER writes
# that file directly - only the OLED daemon does (single-writer
# design, see piratebox_progression.py's own header) - `reset`/`import`
# instead drop a request into the already-bind-mounted /tmp/piratebox
# for the daemon to notice and act on, then remove the request file
# themselves a few seconds later.
#
# The state directory is normally pre-created at boot (root:root 0755)
# by etc/tmpfiles.d/piratebox-tmp.conf specifically so piratebox-
# oled.service's BindReadOnlyPaths has something to bind before this
# script ever runs - `mkdir -p` below is only a defensive fallback for
# the unlikely case that rule hasn't applied yet (e.g. a manual dev
# environment), matching set_piratebox_mode.sh's own belt-and-suspenders
# style.

set -euo pipefail

STATE_DIR="/tmp/piratebox"
SILLY_FILE="$STATE_DIR/silly"
RESET_REQUEST_FILE="$STATE_DIR/progression-reset-request"
IMPORT_REQUEST_FILE="$STATE_DIR/progression-import-request"
PREVIEW_REQUEST_FILE="$STATE_DIR/silly-preview-request"
PREVIEW_WINDOW_SECONDS=45
PROGRESSION_FILE="/var/lib/piratebox-oled/progression.json"
RESET_CONFIRM_TOKEN="RESET-CONFIRMED"
BACKUP_DIR="$HOME/piratebox-progression-backups"

usage() {
    cat >&2 <<'USAGE'
Usage:
  piratebox-silly on
  piratebox-silly off
  piratebox-silly status
  piratebox-silly stats
  piratebox-silly preview
  piratebox-silly backup [path]
  piratebox-silly reset --confirm-i-am-sure [--yes]
  piratebox-silly import <file>
USAGE
    exit 1
}

if [ "$#" -lt 1 ]; then
    usage
fi

ACTION="$1"
shift

case "$ACTION" in
    on|off)
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        # Plain overwrite, not the mktemp+rename atomic pattern
        # set_piratebox_mode.sh uses for trusted state - this is a
        # cosmetic toggle read only by a display loop that already
        # treats anything unexpected as "off," so the tiny window of a
        # torn write is harmless, and a plain write needs no directory-
        # write permission on the (root-owned) parent directory, only
        # on the (moose-owned) file itself.
        printf '%s\n' "$ACTION" > "$SILLY_FILE"
        if [ "$ACTION" = "on" ]; then
            echo "Silly Mode: ON - the OLED will get expressive within a few seconds"
            echo "(unless Emergency Mode or a real fault is active - see 'piratebox-silly status')."
        else
            echo "Silly Mode: OFF - the OLED returns to the plain status rotation."
        fi
        ;;

    status)
        current="off"
        if [ -r "$SILLY_FILE" ] && [ "$(tr -d '[:space:]' < "$SILLY_FILE" 2>/dev/null)" = "on" ]; then
            current="on"
        fi
        echo "Silly Mode: $current"
        if [ -r /tmp/piratebox/mode ] && [ "$(tr -d '[:space:]' < /tmp/piratebox/mode 2>/dev/null)" = "emergency" ]; then
            echo "Note: Emergency Mode is active - Silly Mode is suppressed regardless of this setting."
        fi
        ;;

    stats)
        if [ ! -r "$PROGRESSION_FILE" ]; then
            echo "No Progression data yet (the OLED daemon creates this on first run)." >&2
            exit 1
        fi
        python3 - "$PROGRESSION_FILE" <<'PYEOF'
import json, sys, time
sys.path.insert(0, "/usr/local/bin")
with open(sys.argv[1]) as f:
    s = json.load(f)
xp, stats = s.get("xp", {}), s.get("stats", {})
name = (s.get("device") or {}).get("name") or "(unnamed)"
title = ""
try:
    import piratebox_progression as prog
    title = f" - {prog.title_for_level(xp.get('level', 1))}"
except Exception:
    pass
print(f"{name} - Level {xp.get('level', 1)}{title}, {xp.get('total', 0)} XP")
up = stats.get("lifetime_uptime_seconds", 0)
days = up / 86400.0
print(f"Lifetime uptime: {days:.1f} days")
print(f"Boots observed: {stats.get('boots_observed', 0)}")
print(f"Client encounters (aggregate): {stats.get('total_client_encounters', 0)}")
print(f"Max simultaneous clients: {stats.get('max_simultaneous_clients', 0)}")
print(f"Emergency Mode exercises: {stats.get('emergency_exercises', 0)}")
print(f"SSH sessions observed: {stats.get('ssh_sessions_observed', 0)}")
print(f"Silly Mode days used: {stats.get('silly_days_used', 0)}")
print(f"Achievements unlocked: {len(s.get('achievements', []))}")
age = time.time() - s.get("updated_at", 0)
print(f"(last updated {age:.0f}s ago)")
PYEOF
        ;;

    preview)
        current="off"
        if [ -r "$SILLY_FILE" ] && [ "$(tr -d '[:space:]' < "$SILLY_FILE" 2>/dev/null)" = "on" ]; then
            current="on"
        fi
        if [ "$current" != "on" ]; then
            echo "Silly Mode is currently OFF - the preview has nothing to show." >&2
            echo "Run 'piratebox-silly on' first, then try 'piratebox-silly preview' again." >&2
            exit 1
        fi
        if [ -r /tmp/piratebox/mode ] && [ "$(tr -d '[:space:]' < /tmp/piratebox/mode 2>/dev/null)" = "emergency" ]; then
            echo "Emergency Mode is active - the preview would not be visible right now" >&2
            echo "(Emergency Mode always takes the display, by design). Try again once" >&2
            echo "Emergency Mode clears, or check 'piratebox-silly status'." >&2
            exit 1
        fi
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        printf '%s\n' "$(date +%s)" > "$PREVIEW_REQUEST_FILE"
        echo "Preview started - watch the real OLED for about ${PREVIEW_WINDOW_SECONDS}s."
        echo "This cycles a small sampler of ordinary expressions/animations only -"
        echo "never anything uncommon/rare/legendary/secret, regardless of this"
        echo "device's real level or history - then returns to normal on its own."
        ;;

    backup)
        TARGET="${1:-}"
        if [ ! -r "$PROGRESSION_FILE" ]; then
            echo "No Progression data yet - nothing to back up." >&2
            exit 1
        fi
        if [ -n "$TARGET" ]; then
            cp "$PROGRESSION_FILE" "$TARGET"
            echo "Backed up to: $TARGET"
        else
            mkdir -p "$BACKUP_DIR"
            OUT="$BACKUP_DIR/progression-$(date +%Y%m%d-%H%M%S).json"
            cp "$PROGRESSION_FILE" "$OUT"
            echo "Backed up to: $OUT"
        fi
        ;;

    reset)
        CONFIRMED=0
        FORCE=0
        for arg in "$@"; do
            case "$arg" in
                --confirm-i-am-sure) CONFIRMED=1 ;;
                --yes|-y) FORCE=1 ;;
            esac
        done
        if [ "$CONFIRMED" -ne 1 ]; then
            echo "This PERMANENTLY erases all XP, levels, achievements, and history." >&2
            echo "It does NOT affect networking, Emergency Mode, or any core PirateBox function." >&2
            echo "Usage: piratebox-silly reset --confirm-i-am-sure [--yes]" >&2
            exit 1
        fi
        if [ "$FORCE" -ne 1 ]; then
            echo "This PERMANENTLY erases all Progression history (XP, levels, achievements)."
            printf 'Type RESET to confirm: '
            read -r reply
            if [ "$reply" != "RESET" ]; then
                echo "Not confirmed - nothing was changed."
                exit 1
            fi
        fi
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        printf '%s\n' "$RESET_CONFIRM_TOKEN" > "$RESET_REQUEST_FILE"
        echo "Reset requested - waiting for the OLED daemon to apply it..."
        sleep 4
        rm -f "$RESET_REQUEST_FILE" 2>/dev/null || true
        if [ -r "$PROGRESSION_FILE" ]; then
            python3 - "$PROGRESSION_FILE" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    s = json.load(f)
print("Progression reset." if s.get("xp", {}).get("total", -1) == 0 else
      "Reset requested, but could not be confirmed yet - check again with 'piratebox-silly stats'.")
PYEOF
        else
            echo "Reset requested (no prior data file existed to confirm against)."
        fi
        ;;

    import)
        SRC="${1:-}"
        if [ -z "$SRC" ] || [ ! -r "$SRC" ]; then
            echo "Usage: piratebox-silly import <file>" >&2
            exit 1
        fi
        mkdir -p "$STATE_DIR" 2>/dev/null || true
        cp "$SRC" "$IMPORT_REQUEST_FILE"
        echo "Import requested - waiting for the OLED daemon to validate it..."
        sleep 4
        rm -f "$IMPORT_REQUEST_FILE" 2>/dev/null || true
        echo "Done - check 'piratebox-silly stats' to confirm it was adopted, or"
        echo "'journalctl -u piratebox-oled -n 20' if it looks unchanged (a malformed"
        echo "file is rejected and logged, never partially applied)."
        ;;

    *)
        usage
        ;;
esac
