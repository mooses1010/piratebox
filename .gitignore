# Stage 19: "Take This With You" export bundles - 100% regenerable from
# data/utility/* via tools/build_export_bundles.py, same "generated,
# don't hand-sync two copies" convention as QR codes/VERSION below. Run
# that script after deploying to (re)build these on the live box.
var/www/html/public/utility/exports/

# Admin page credential (Phase 4) - never generated/stored inside the repo
# tree by any script here, but ignored defensively in case anyone copies
# it in locally while testing.
*.piratebox_admin_htpasswd

# QR codes (Phase 5) - generated fresh at install time by the installer
# via qrencode, not committed (see installer_pi_zero_trixie.sh).
var/www/html/public/assets/qr-url.png
var/www/html/public/assets/qr-wifi.png
